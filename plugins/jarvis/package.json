{
  "name": "bb-plugin-jarvis",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Jarvis",
    "description": "Coordinate BB sessions with durable task ownership and explicit controls.",
    "branding": {
      "icon": "AudioLines"
    },
    "server": "./server.ts",
    "app": "./app.tsx"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "typecheck": "npm run voice:build && tsc --noEmit",
    "build": "npm run voice:build && bb plugin build .",
    "voice:install": "cd voice && ONNXRUNTIME_NODE_INSTALL=skip npm ci",
    "voice:build": "npm --prefix voice run build",
    "voice:test": "npm --prefix voice test",
    "voice:start": "npm --prefix voice start"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@get-bb/plugin-sdk": "0.6.132",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.7.0"
  }
}
